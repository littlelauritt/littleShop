{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "d21736f7d0e279e2372f8656e5e7d074!",
    "Issuer": "littleshop.local",
    "Audience": "littleshop.client"
  },
  "ReverseProxy": {
    "Routes": {
      // -----------------------------------------------------------
      // 1. IDENTITY (Usuarios)
      // -----------------------------------------------------------
      "identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "public_access", // Login es público
        "RateLimiterPolicy": "anonymous",
        "Match": {
          "Path": "/api/Account/{**catch-all}"
        }
      },
      "identity-admin-roles": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/admin/roles/{**catch-all}"
        }
      },
      "identity-admin-users": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        }
      },
      "identity-profile": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/Profile/{**catch-all}"
        }
      },

      // -----------------------------------------------------------
      // 2. CATALOG (Productos) - ¡NUEVO!
      // -----------------------------------------------------------
      "catalog-products": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "public_access", // Público (para ver escaparate)
        "RateLimiterPolicy": "anonymous",
        "Match": {
          // Coincide con tu Minimal API: /api/v1/products
          "Path": "/api/v1/products/{**catch-all}"
        }
      },

      // -----------------------------------------------------------
      // 3. ORDERS (Pedidos) - Futuro
      // -----------------------------------------------------------
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "authenticated", // Solo si estás logueado
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/orders" }
        ]
      }
    },
    "Clusters": {
      // -----------------------------------------------------------
      // DESTINOS (Donde viven los servicios)
      // -----------------------------------------------------------
      "identity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "https+http://littleshop-identity"
          }
        }
      },
      "catalog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            // Debe coincidir con el nombre en AppHost .AddProject<...>("littleshop-catalog")
            "Address": "https+http://littleshop-catalog"
          }
        }
      },
      "orders-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            // Debe coincidir con el nombre en AppHost (cuando crees el proyecto)
            "Address": "https+http://littleshop-orders"
          }
        }
      }
    }
  }
}